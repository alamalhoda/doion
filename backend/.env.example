# Copy to `.env` for local development:
#   cp .env.example .env
#
# On Chabokan: set the same keys in the service panel (do NOT upload `.env`).
# OS/panel env always overrides values from this file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-local-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Daily (recommended): Compose Postgres at repo root; Django still on the host.
DATABASE_URL=postgres://doion@localhost:5432/doion
# SQLite (no Docker): comment the line above and use:
# DATABASE_URL=sqlite:///db.sqlite3
# config.settings.local uses SQLite unless DATABASE_URL starts with postgres.

# Local only: set to True/1 to use db.demo.sqlite3 instead of db.sqlite3 (isolated demo seed)
# DJANGO_DEMO_DATABASE=False

# Optional: password for `manage.py seed_demo --password …` (local/demo only; never production secrets)
# DEMO_SEED_PASSWORD=

# --- Cache / Celery (optional locally; LocMemCache is used in local.py) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- Auth / registration ---
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
ACCOUNT_EMAIL_VERIFICATION=none

# --- Email (console in local) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Production / Chabokan only (examples; leave unset locally) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ADMIN_URL=hidden-admin-path/
# DJANGO_ALLOWED_HOSTS=your-api.chbkn.dev
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-api.chbkn.dev
# CORS_ALLOWED_ORIGINS=https://chequeyar-front.chbkn.dev
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DJANGO_SECURE_SSL_REDIRECT=True
# WSGI_PATH=config.wsgi
